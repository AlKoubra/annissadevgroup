MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=annissa
SESSION_SECRET=change-this-to-a-long-random-string
# Secret pour /api/reminders/run (rappels de RDV) — Vercel l'envoie automatiquement
# en "Authorization: Bearer $CRON_SECRET" si une env var CRON_SECRET existe sur le
# projet ; sinon un pingeur externe (cron-job.org...) peut l'appeler avec ?key=...
CRON_SECRET=change-this-to-a-long-random-string-too
NODE_ENV=production
